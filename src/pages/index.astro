---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Mission from "../components/sections/Mission.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Footer from "../components/Footer.astro";

import content from "../content/landing.de.json";
---

<BaseLayout title={content.seo.title} description={content.seo.description}>
  <Hero content={content.hero} />
  <Mission content={content.mission} />
  <HowItWorks content={content.howItWorks} />
  <Footer contact={content.contact} footer={content.footer} />
</BaseLayout>
